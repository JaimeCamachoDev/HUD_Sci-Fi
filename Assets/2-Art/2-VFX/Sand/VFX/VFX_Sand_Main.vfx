  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661614662}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661617257}
  - {fileID: 8926484042661617258}
  - {fileID: 8926484042661617259}
  - {fileID: 8926484042661617260}
  - {fileID: 8926484042661617261}
  - {fileID: 8926484042661617262}
  - {fileID: 8926484042661617263}
  - {fileID: 8926484042661617264}
  - {fileID: 8926484042661617265}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661617256}
  m_BlockName: Sand Hold & Rise (pegada -> se suelta -> sube)
  m_HLSLCode: "void SandHoldRise(inout VFXAttributes attributes, in float4x4 localToWorld,
    in float dt, in float holdTime, in float stickStrength, in float moveStrength,
    in float riseSpeed, in float twinkle, in float energy, in float motion)\n{\n   
    uint id = attributes.particleId * 9u;\n    float r0 = FixedRand(id + 0u);\n   
    float r1 = FixedRand(id + 1u);\n    float r2 = FixedRand(id + 2u);\n    float
    e = saturate(energy);\n    float m = saturate(motion);\n    float life = attributes.age
    / max(attributes.lifetime, 1e-3);\n    float dts = max(dt, 1e-4);\n    float
    dti = min(dt, 0.033);\n\n    // Ancla en mundo (se mueve/rota/escala con el simbolo)
    y su velocidad\n    float3 anchor = mul(localToWorld, float4(attributes.anchorLocal,
    1.0)).xyz;\n    float3 anchorVel = (anchor - attributes.anchorPrev) / dts;\n   
    float av = length(anchorVel);\n    if (av > 5.0) anchorVel *= 5.0 / av;\n   
    attributes.anchorPrev = anchor;\n\n    // Agarre: 1 al nacer, se suelta tras
    holdTime (fraccion de vida). Con energia se sueltan antes.\n    float h = holdTime
    * (0.5 + r0) * lerp(1.0, 0.6, e) + 0.35 * m;   // en movimiento aguantan mas\n   
    float hold = 1.0 - smoothstep(h, h + 0.3, life);\n\n    // Muelle hacia el ancla
    (solo mientras agarra), amortiguado respecto a la velocidad del ancla\n    float
    k = lerp(stickStrength, moveStrength, m) * hold;\n    float3 acc = k * (anchor
    - attributes.position) - 2.0 * sqrt(k) * (attributes.velocity - anchorVel);\n\n   
    // Libre: sube despacio (mas rapido con energia) y se frena lo lateral\n    float
    free = 1.0 - hold;\n    float rise = riseSpeed * lerp(0.6, 1.8, e) * (0.6 + 0.8
    * r1);\n    acc.y += (rise - attributes.velocity.y) * 2.0 * free;\n    acc.xz
    -= attributes.velocity.xz * 1.2 * free;\n    attributes.velocity += acc * dti;\n\n   
    // Destello: lento en calma, rapido con energia\n    float tw = 0.5 + 0.5 * sin(attributes.age
    * lerp(1.5, 8.0, e) * (0.6 + 0.8 * r2) + r1 * 6.2831);\n    attributes.alpha
    = lerp(1.0, 0.3 + 0.7 * tw * tw, twinkle);\n\n    // Si el simbolo se teletransporta,
    las que quedan muy lejos desaparecen\n    if (length(attributes.position - anchor)
    > 1.5)\n        attributes.alive = false;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandHoldRise
    selectedIndex: 0
