  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661614613}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661617247}
  - {fileID: 8926484042661617248}
  - {fileID: 8926484042661617249}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661617246}
  m_BlockName: Sand Anchor (superficie del simbolo)
  m_HLSLCode: "void SandAnchor(inout VFXAttributes attributes, in float4x4 shapeTransform,
    in float4x4 localToWorld, in float surfaceOffset)\n{\n    float r = FixedRand(attributes.particleId
    * 9u + 7u);\n    float3 p = mul(shapeTransform, float4(attributes.position, 1.0)).xyz;\n   
    float3 n = normalize(mul((float3x3)shapeTransform, attributes.direction) + 1e-5);\n   
    float3 anchor = p + n * surfaceOffset * (r * 2.0 - 0.5);\n    attributes.anchorLocal
    = anchor;                       // ancla en espacio local del VFX\n    attributes.position
    = mul(localToWorld, float4(anchor, 1.0)).xyz;\n    attributes.anchorPrev = attributes.position;             
    // ancla en mundo del frame anterior\n    attributes.velocity = float3(0, 0,
    0);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandAnchor
    selectedIndex: 0
